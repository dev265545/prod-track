# Portal (download gate) — copy to `.env.local` for local dev

# Shared secret users type on the landing page (distribute securely).
ACCESS_KEY=change-me-to-a-long-random-string

# Used to sign the session cookie; min 16 chars, keep secret.
PORTAL_SESSION_SECRET=change-me-another-long-random-string

# Latest portable ZIP: either point at GitHub Releases…
GITHUB_REPOSITORY=your-org/prod-track
# Optional: raises API rate limits and is required for private repos / API asset download
# GITHUB_TOKEN=

# If releases ship portal-manifest.json with UploadThing (private files), the
# portal server needs the same UploadThing token to mint short-lived signed URLs
# when users hit /api/download (never put this in NEXT_PUBLIC_*).
# UPLOADTHING_TOKEN=

# …or bypass GitHub and stream this URL after login (S3 signed URL, CDN, etc.)
# LATEST_ZIP_URL=https://example.com/ProdTrack-portable.zip
